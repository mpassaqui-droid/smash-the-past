  characterName: "Miyamoto Musashi"
  bio: "Espadach\u00edn japon\u00e9s y autor de El libro de los cinco anillos. En la arena, trae dos espadas y ninguna mano para excusas."
  maxHealth: 100
  moveSpeed: 5
